# ============================================================================
# CineMega — Environment Configuration (.env.example)
# ============================================================================

# --- 1. SUPABASE DATABASE (Server-Side Only — Never expose to Vite client) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- 2. ADMIN AUTHENTICATION & SECURITY (Server-Side Only) ---
# Optional default admin override passcode or bootstrap password
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=admin@cinemega.local
ADMIN_PASSCODE=
SESSION_SECRET=
ALLOWED_ORIGINS=http://localhost:3000

# --- 3. CACHE & STREAMING CONFIGURATION (Server-Side Only) ---
INSPECT_CACHE_TTL_MS=86400000
TICKET_CACHE_TTL_MS=1800000
STREAM_BLOCK_CACHE_LIMIT_MB=256
MEGA_GATEWAY_TIMEOUT_MS=25000

# --- 4. FRONTEND API & DISTRIBUTED WORKER POOL (Exposed to Vite Client) ---
# Single primary API backend URL (leave empty to default to current origin)
VITE_API_BASE_URL=

# Comma-separated distributed backend worker URLs (Cloudflare, Vercel, Netlify)
# Example: VITE_WORKER_URLS=https://cinemega-worker.example.workers.dev,https://cinemega-api.vercel.app,https://cinemega-api.netlify.app
VITE_WORKER_URLS=

# --- 5. AI STUDIO / PLATFORM RUNTIME ---
GEMINI_API_KEY=
APP_URL=http://localhost:3000
